# Copy to Hostinger Environment variables (do not commit real secrets).
NODE_ENV=production

# Hostinger assigns PORT. Leave unset on Hostinger. Local default is 5173.
# PORT=5173

# Hostinger MySQL on the same plan: host is localhost.
# Remote MySQL: use the host shown in hPanel → Databases.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Optional instead of the DB_* fields:
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Set to 1 only if the MySQL host requires TLS.
# DB_SSL=0

BUSINESS_ID=00000000-0000-4000-8000-000000000001
MASTER_ADMIN_EMAIL=master@yourdomain.com
MASTER_ADMIN_PASSWORD=change-me-strong
DEMO_TENANT_PASSWORD=Demo@12345
CASHIER_PASSWORD=Cashier@12345

# Cookies: production HTTPS sets Secure automatically. Use 0 only for local http.
# COOKIE_SECURE=1
