# ATAV POS — Passenger (Hostinger / CloudLinux)
# Do not add a React/SPA fallback to index.html — that returns a web page for /api and /pos-data.
PassengerEnabled on
PassengerAppType node
PassengerStartupFile server.js
PassengerFriendlyErrorPages off
Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:api|pos-data|atav-data)(?:/|$) - [END]
  RewriteRule ^(?:health\.json|atavpos-rpc\.json)$ - [END]
</IfModule>
